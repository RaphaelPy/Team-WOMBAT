<Page x:Class="Banking_app.CreateUser_Admin_"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Banking_app"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Background="Transparent"
      Title="CreateUser_Admin_">

    <Grid Margin="40">

        <Border Background="#0E3A63"
                Padding="30"
                CornerRadius="6"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">

            <StackPanel Width="320">

                <TextBlock Text="Neuen Benutzer erstellen"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="White"
                           Margin="0,0,0,20"/>

                <TextBlock Text="Username"
                           Foreground="White"/>

                <TextBox x:Name="tbUsername"
                         Height="30"
                         Margin="0,5,0,15"/>

                <TextBlock Text="Passwort"
                           Foreground="White"/>

                <PasswordBox x:Name="tbPassword"
                             Height="30"
                             Margin="0,5,0,15"/>

                <TextBlock Text="Rolle"
                           Foreground="White"/>

                <ComboBox x:Name="cbRole"
                          Height="30"
                          Margin="0,5,0,20">

                    <ComboBoxItem Content="USER"/>
                    <ComboBoxItem Content="ADMIN"/>

                </ComboBox>

                <Button Content="Benutzer erstellen"
                        Height="40"
                        Background="#2D4C9C"
                        Foreground="White"
                        BorderThickness="0"
                        Click="CreateUser_Click"/>

            </StackPanel>

        </Border>

    </Grid>
</Page>