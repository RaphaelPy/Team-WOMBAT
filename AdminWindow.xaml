<Window
    x:Class="Banking_app.AdminWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Wombat Bank - Admin"
    Width="1000"
    Height="600"
    MinWidth="1000"
    MinHeight="600"
    Icon="/Wombat_Bank.ico"
    Loaded="AdminWindow_Loaded"
    Background="#0B2A4A"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <StackPanel
            Grid.Column="0"
            Margin="12"
            Background="#0E3A63">
            <TextBlock
                Margin="10,10,10,14"
                FontSize="18"
                FontWeight="SemiBold"
                Foreground="White"
                Text="Admin Menü" />
            <Button
                Height="40"
                Margin="10,0,10,10"
                Background="#2D4C9C"
                Foreground="White"
                BorderThickness="0"
                Click="Users_Click"
                Content="Benutzerverwaltung" />
            <Button
                Height="40"
                Margin="10,0,10,10"
                Background="#2D4C9C"
                Foreground="White"
                BorderThickness="0"
                Click="CreateUser_Click"
                Content="User erstellen" />
            <Button
                Height="40"
                Margin="10,0,10,10"
                Background="#2D4C9C"
                Foreground="White"
                BorderThickness="0"
                Click="DeleteUser_Click"
                Content="User löschen" />
            <Separator
                Margin="10,10"
                Background="#1E4F8A"/>
            <Button
                Height="40"
                Margin="10,0,10,10"
                Background="#2D4C9C"
                Foreground="White"
                BorderThickness="0"
                Click="Logout_Click"
                Content="Logout" />

        </StackPanel>

        <!-- Content -->
        <Frame
            x:Name="AdminFrame"
            Grid.Column="1"
            Margin="12"
            Background="#0B2A4A"
            NavigationUIVisibility="Hidden" />

    </Grid>
</Window>