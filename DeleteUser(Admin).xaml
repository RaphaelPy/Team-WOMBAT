<Page x:Class="Banking_app.DeleteUser_Admin_"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Background="#0B2A4A"
      Title="DeleteUser_Admin_">

    <Grid Margin="40">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titel -->
        <TextBlock Text="Benutzer löschen"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="White"
                   Margin="0,0,0,20"/>

        <!-- DataGrid -->
        <DataGrid x:Name="dgUsers"
                  Grid.Row="1"
                  Margin="0,10"
                  Background="#0E3A63"
                  Foreground="White"
                  BorderBrush="#1E4F8A"
                  RowBackground="#0E3A63"
                  AlternatingRowBackground="#103F6E"
                  ColumnHeaderHeight="35"
                  AutoGenerateColumns="True"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow">

            <!-- Header Style -->
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#1E4F8A"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="BorderBrush" Value="#1E4F8A"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

        </DataGrid>

        <!-- Button -->
        <Button Grid.Row="2"
                Content="Ausgewählten Benutzer löschen"
                Height="40"
                Margin="0,20,0,0"
                Background="#2D4C9C"
                Foreground="White"
                BorderThickness="0"
                Click="DeleteUser_Click"/>

    </Grid>

</Page>