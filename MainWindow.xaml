<Window
    x:Class="Banking_app.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Wombat Bank - User"
    Width="900"
    Height="520"
    Icon="/Wombat_Bank.ico"
    Loaded="MainWindow_Loaded"
    Background="#0B2A4A">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <DockPanel Grid.Column="0" Background="#0E3A63">

            <!-- Logout unten -->
            <Button
                Height="34"
                Margin="10"
                Background="#2D4C9C"
                Foreground="White"
                BorderThickness="0"
                Click="Logout_Click"
                Content="Logout"
                DockPanel.Dock="Bottom" />

            <StackPanel Margin="10">

                <TextBlock
                    Margin="0,0,0,10"
                    FontWeight="SemiBold"
                    FontSize="16"
                    Foreground="White"
                    Text="Menü" />

                <ListBox
                    x:Name="MenuList"
                    Background="#0E3A63"
                    BorderThickness="0"
                    Foreground="White"
                    SelectionChanged="MenuList_SelectionChanged">

                    <ListBoxItem Content="Start" />
                    <ListBoxItem Content="Konto" />
                    <ListBoxItem Content="Transaktionen" />
                    <ListBoxItem Content="Karten" />
                    <ListBoxItem Content="Einstellungen" />

                </ListBox>

            </StackPanel>
        </DockPanel>

        <!-- Content -->
        <Frame
            x:Name="MainFrame"
            Grid.Column="1"
            Background="#0B2A4A"
            NavigationUIVisibility="Hidden" />

    </Grid>
</Window>