<Page
    x:Class="Banking_app.userpages.KontoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Konto"
    Background="#0B2A4A">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Links -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="10" Background="#0E3A63">

                <TextBlock
                    Margin="10,10,10,12"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="Konto" />

                <!-- Konto  -->
                <TextBlock Margin="10,0,10,4" Foreground="White" Text="Konto auswählen" />

                <ComboBox
                    x:Name="CbAccounts"
                    Height="32"
                    Margin="10,0,10,0"
                    Background="#1E4F8A"
                    Foreground="White"
                    BorderBrush="#1E4F8A"
                    SelectionChanged="CbAccounts_SelectionChanged" />

                <!-- Kontostand -->
                <Border
                    Margin="10,12,10,12"
                    Padding="10"
                    Background="#103F6E"
                    BorderBrush="#1E4F8A"
                    BorderThickness="1">

                    <StackPanel>

                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="Kontostand" />

                        <TextBlock
                            x:Name="TxtBalance"
                            Margin="0,6,0,0"
                            FontSize="22"
                            Foreground="White"
                            Text="—" />

                        <TextBlock
                            x:Name="TxtIban"
                            Margin="0,6,0,0"
                            Foreground="#D6E4FF"
                            Text="IBAN: —" />

                        <TextBlock
                            x:Name="TxtAccStatus"
                            Margin="0,2,0,0"
                            Foreground="#D6E4FF"
                            Text="Status: —" />

                    </StackPanel>

                </Border>

                <TextBlock
                    Margin="10,0,10,8"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="Überweisung" />

                <TextBlock Margin="10,0,10,4" Foreground="White" Text="Empfänger Name" />
                <TextBox x:Name="TbToName" Height="30" Margin="10,0,10,0" Background="#103F6E" Foreground="White" BorderBrush="#1E4F8A"/>

                <TextBlock Margin="10,10,10,4" Foreground="White" Text="Empfänger IBAN" />
                <TextBox x:Name="TbToIban" Height="30" Margin="10,0,10,0" Background="#103F6E" Foreground="White" BorderBrush="#1E4F8A"/>

                <TextBlock Margin="10,10,10,4" Foreground="White" Text="Betrag" />
                <TextBox x:Name="TbAmount" Height="30" Margin="10,0,10,0" Background="#103F6E" Foreground="White" BorderBrush="#1E4F8A"/>

                <TextBlock Margin="10,10,10,4" Foreground="White" Text="Verwendungszweck (optional)" />
                <TextBox x:Name="TbPurpose" Height="30" Margin="10,0,10,0" Background="#103F6E" Foreground="White" BorderBrush="#1E4F8A"/>

                <Button
                    x:Name="BtnSend"
                    Height="40"
                    Margin="10,12,10,0"
                    Background="#2D4C9C"
                    Foreground="White"
                    BorderThickness="0"
                    Click="Send_Click"
                    Content="Überweisung ausführen" />

                <Button
                    Height="36"
                    Margin="10,10,10,10"
                    Background="#2D4C9C"
                    Foreground="White"
                    BorderThickness="0"
                    Click="Reload_Click"
                    Content="Neu laden" />

            </StackPanel>

        </ScrollViewer>

        <!-- Rechts-->
        <Grid Grid.Column="1" Margin="10">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                Margin="0,0,0,8"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="White"
                Text="Letzte Transaktionen" />

            <DataGrid
                x:Name="DgTransfers"
                Grid.Row="1"
                Background="#0E3A63"
                Foreground="White"
                BorderBrush="#1E4F8A"
                RowBackground="#0E3A63"
                AlternatingRowBackground="#103F6E"
                ColumnHeaderHeight="35"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                SelectionMode="Single">

                <!-- Header Style -->
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#1E4F8A"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="BorderBrush" Value="#1E4F8A"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Width="160" Binding="{Binding created_at}" Header="Zeit"/>
                    <DataGridTextColumn Width="70" Binding="{Binding direction}" Header="Typ"/>
                    <DataGridTextColumn Width="*" Binding="{Binding partner}" Header="Partner"/>
                    <DataGridTextColumn Width="220" Binding="{Binding partner_iban}" Header="IBAN"/>
                    <DataGridTextColumn Width="110" Header="Betrag">

                        <DataGridTextColumn.Binding>
                            <Binding Path="amount_signed" StringFormat="{}{0:+0.00;-0.00}" />
                        </DataGridTextColumn.Binding>

                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">

                                <Setter Property="FontWeight" Value="SemiBold"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding direction}" Value="IN">
                                        <Setter Property="Foreground" Value="#3DDC84"/>
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding direction}" Value="OUT">
                                        <Setter Property="Foreground" Value="#FF6B6B"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Width="90" Binding="{Binding status}" Header="Status"/>
                </DataGrid.Columns>
            </DataGrid>

        </Grid>
    </Grid>
</Page>