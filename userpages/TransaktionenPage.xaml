<Page
    x:Class="Banking_app.userpages.TransaktionenPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Transaktionen"
    Background="#0B2A4A">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Links-->
        <StackPanel Grid.Column="0" Margin="10" Background="#0E3A63">

            <TextBlock
                Margin="10,10,10,12"
                FontSize="18"
                FontWeight="SemiBold"
                Foreground="White"
                Text="Transaktionen" />

            <Button
                Height="40"
                Margin="10,0,10,10"
                Background="#2D4C9C"
                Foreground="White"
                BorderThickness="0"
                Click="Reload_Click"
                Content="Neu laden" />

            <Button
                Height="40"
                Margin="10,0,10,10"
                Background="#2D4C9C"
                Foreground="White"
                BorderThickness="0"
                Click="ShowAll_Click"
                Content="Alle" />

            <Button
                Height="40"
                Margin="10,0,10,10"
                Background="#2D4C9C"
                Foreground="White"
                BorderThickness="0"
                Click="ShowOnlyFailed_Click"
                Content="Nur fehlgeschlagen" />
        </StackPanel>

        <!-- Rechts -->
        <DataGrid
            x:Name="dgTransfers"
            Grid.Column="1"
            Margin="10"
            Background="#0E3A63"
            Foreground="White"
            BorderBrush="#1E4F8A"
            RowBackground="#0E3A63"
            AlternatingRowBackground="#103F6E"
            ColumnHeaderHeight="35"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            SelectionMode="Single">

            <!-- Header Style -->
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#1E4F8A"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="BorderBrush" Value="#1E4F8A"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>

                <DataGridTextColumn
                    Width="160"
                    Binding="{Binding created_at}"
                    Header="Zeit" />

                <DataGridTextColumn
                    Width="70"
                    Binding="{Binding direction}"
                    Header="Typ" />

                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding partner}"
                    Header="Partner" />

                <DataGridTextColumn
                    Width="220"
                    Binding="{Binding partner_iban}"
                    Header="IBAN" />

                <!-- Betrag -->
                <DataGridTextColumn Width="110" Header="Betrag">
                    <DataGridTextColumn.Binding>
                        <Binding Path="amount_signed" StringFormat="{}{0:+0.00;-0.00}" />
                    </DataGridTextColumn.Binding>

                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="SemiBold" />

                            <Style.Triggers>

                                <DataTrigger Binding="{Binding direction}" Value="IN">
                                    <Setter Property="Foreground" Value="#3DDC84"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding direction}" Value="OUT">
                                    <Setter Property="Foreground" Value="#FF6B6B"/>
                                </DataTrigger>

                            </Style.Triggers>

                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn
                    Width="90"
                    Binding="{Binding status}"
                    Header="Status" />

            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</Page>