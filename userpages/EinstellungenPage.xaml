<Page
    x:Class="Banking_app.userpages.EinstellungenPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Einstellungen"
    Background="#0B2A4A">

    <Grid>
        <Border
            Width="420"
            Padding="30"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#0E3A63"
            BorderBrush="#1E4F8A"
            BorderThickness="1"
            CornerRadius="14">

            <StackPanel>

                <!-- Titel -->
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="Passwort ändern" />

                <TextBlock
                    Margin="0,6,0,20"
                    FontSize="12"
                    Foreground="#D6E4FF"
                    Text="Bitte gib dein aktuelles Passwort ein und wähle ein neues."
                    TextAlignment="Center" />

                <!-- Aktuelles Passwort -->
                <TextBlock
                    Margin="0,0,0,6"
                    FontSize="12"
                    Foreground="#D6E4FF"
                    Text="Aktuelles Passwort" />

                <PasswordBox
                    x:Name="TxtOldPassword"
                    Height="36"
                    Margin="0,0,0,16"
                    Padding="10"
                    Background="#103F6E"
                    Foreground="White"
                    BorderBrush="#1E4F8A"
                    BorderThickness="1" />

                <!-- Neues Passwort -->
                <TextBlock
                    Margin="0,0,0,6"
                    FontSize="12"
                    Foreground="#D6E4FF"
                    Text="Neues Passwort" />

                <PasswordBox
                    x:Name="TxtNewPassword"
                    Height="36"
                    Margin="0,0,0,16"
                    Padding="10"
                    Background="#103F6E"
                    Foreground="White"
                    BorderBrush="#1E4F8A"
                    BorderThickness="1" />

                <!-- Wiederholen -->
                <TextBlock
                    Margin="0,0,0,6"
                    FontSize="12"
                    Foreground="#D6E4FF"
                    Text="Neues Passwort wiederholen" />

                <PasswordBox
                    x:Name="TxtRepeatPassword"
                    Height="36"
                    Margin="0,0,0,12"
                    Padding="10"
                    Background="#103F6E"
                    Foreground="White"
                    BorderBrush="#1E4F8A"
                    BorderThickness="1" />

                <!-- Fehlermeldung -->
                <TextBlock
                    x:Name="TxtError"
                    Margin="0,0,0,12"
                    FontSize="12"
                    Foreground="#FF6B6B"
                    TextAlignment="Center"
                    Visibility="Collapsed" />

                <!-- Button -->
                <Button
                    Height="40"
                    Background="#2D4C9C"
                    BorderThickness="0"
                    Click="Button_Click"
                    Content="Passwort ändern"
                    Cursor="Hand"
                    Foreground="White">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>