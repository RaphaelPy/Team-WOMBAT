<Page
    x:Class="Banking_app.userpages.KartenPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Karten"
    Background="#0B2A4A">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Buttons -->
        <StackPanel Grid.Column="0" Margin="10" Background="#0E3A63">

            <TextBlock
                Margin="10,10,10,12"
                FontSize="18"
                FontWeight="SemiBold"
                Foreground="White"
                Text="Karten" />

            <Button
                Height="40"
                Margin="10,0,10,10"
                Background="#2D4C9C"
                Foreground="White"
                BorderThickness="0"
                Click="Reload_Click"
                Content="Neu laden" />

            <Button
                Height="40"
                Margin="10,0,10,10"
                Background="#2D4C9C"
                Foreground="White"
                BorderThickness="0"
                Click="ToggleBlock_Click"
                Content="Sperren / Entsperren" />

        </StackPanel>

        <!-- DataGrid -->
        <DataGrid
            x:Name="dgCards"
            Grid.Column="1"
            Margin="10"
            Background="#0E3A63"
            Foreground="White"
            BorderBrush="#1E4F8A"
            RowBackground="#0E3A63"
            AlternatingRowBackground="#103F6E"
            ColumnHeaderHeight="35"
            AutoGenerateColumns="True"
            IsReadOnly="True"
            SelectionMode="Single">

            <!-- Header Style -->
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#1E4F8A"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="BorderBrush" Value="#1E4F8A"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

        </DataGrid>

    </Grid>
</Page>