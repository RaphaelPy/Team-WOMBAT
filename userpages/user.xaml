<Page
    x:Class="Banking_app.user"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="user"
    Background="#0B2A4A">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Begrüßung -->
        <StackPanel Grid.Row="0">
            <TextBlock
                FontSize="22"
                FontWeight="SemiBold"
                Foreground="White"
                Text="Dashboard" />

            <TextBlock
                x:Name="txtWelcome"
                Margin="0,8,0,0"
                FontSize="14"
                Foreground="#D6E4FF"
                Text="Willkommen!" />
        </StackPanel>

        <!-- Kontostand -->
        <Border
            Grid.Row="1"
            Margin="0,16,0,0"
            Padding="16"
            Background="#0E3A63"
            BorderBrush="#1E4F8A"
            BorderThickness="1"
            CornerRadius="6">

            <StackPanel>
                <TextBlock 
                    FontWeight="SemiBold"
                    Foreground="#D6E4FF"
                    Text="Gesamtguthaben" />

                <TextBlock
                    x:Name="txtBalance"
                    Margin="0,8,0,0"
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="0,00 €" />
            </StackPanel>

        </Border>

        <!-- Schnellaktionen -->
        <StackPanel
            Grid.Row="2"
            Margin="0,20,0,0"
            Orientation="Horizontal">

            <Button
                Width="140"
                Height="40"
                Margin="0,0,10,0"
                Background="#2D4C9C"
                Foreground="White"
                BorderThickness="0"
                Click="Gotokonto"
                Content="Überweisung" />

            <Button
                Width="140"
                Height="40"
                Margin="0,0,10,0"
                Background="#2D4C9C"
                Foreground="White"
                BorderThickness="0"
                Click="gototransaktionen"
                Content="Transaktionen" />

            <Button
                Width="140"
                Height="40"
                Background="#2D4C9C"
                Foreground="White"
                BorderThickness="0"
                Click="gotokarten"
                Content="Karten" />
        </StackPanel>

        <!-- Letzte Transaktionen -->
        <StackPanel Grid.Row="3" Margin="0,20,0,0">

            <TextBlock
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="White"
                Text="Letzte Transaktionen" />

            <DataGrid
                x:Name="dgRecentTransfers"
                Height="220"
                Margin="0,10,0,0"
                Background="#0E3A63"
                Foreground="White"
                BorderBrush="#1E4F8A"
                AutoGenerateColumns="True"
                IsReadOnly="True" />
        </StackPanel>

    </Grid>
</Page>